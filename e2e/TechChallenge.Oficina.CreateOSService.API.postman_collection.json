      "name": "01 - Fluxo Principal",
      "item": [
        {
          "name": "Criar Ordem de Servico Completa (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{createOSServiceBaseUrl}}/api/ordens-servico/completa",
              "host": [
                "{{createOSServiceBaseUrl}}"
              ],
              "path": [
                "api",
                "ordens-servico",
                "completa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": {\n    \"nomeCompleto\": \"{{createos_cliente_nome}}\",\n    \"identificacao\": \"{{createos_cliente_identificacao}}\",\n    \"email\": \"{{createos_cliente_email}}\"\n  },\n  \"veiculo\": {\n    \"placa\": \"{{createos_veiculo_placa}}\",\n    \"marca\": \"Chevrolet\",\n    \"modelo\": \"Onix\",\n    \"ano\": 2023,\n    \"renavam\": \"{{createos_veiculo_renavam}}\"\n  },\n  \"servicos\": [\n    {\n      \"nome\": \"Revisao {{createos_stamp}}\",\n      \"descricao\": \"Revisao completa da ordem {{createos_stamp}}\",\n      \"itensServico\": [\n        {\n          \"insumo\": {\n            \"nome\": \"Oleo 5W30 {{createos_stamp}}\",\n            \"fabricante\": \"Mobil\",\n            \"quantidadeDisponivel\": 20,\n            \"valorUnitario\": 35.0\n          },\n          \"quantidade\": 4\n        }\n      ]\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function gerarCpfValido() {",
                  "  const base = [];",
                  "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
                  "  let soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
                  "  let resto = soma % 11;",
                  "  const d1 = resto < 2 ? 0 : 11 - resto;",
                  "  soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
                  "  soma += d1 * 2;",
                  "  resto = soma % 11;",
                  "  const d2 = resto < 2 ? 0 : 11 - resto;",
                  "  return [...base, d1, d2].join('');",
                  "}",
                  "function gerarPlacaMercosul() {",
                  "  const letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
                  "  const digitos = '0123456789';",
                  "  return letras[Math.floor(Math.random() * 26)] + letras[Math.floor(Math.random() * 26)] + letras[Math.floor(Math.random() * 26)] + digitos[Math.floor(Math.random() * 10)] + letras[Math.floor(Math.random() * 26)] + digitos[Math.floor(Math.random() * 10)] + digitos[Math.floor(Math.random() * 10)];",
                  "}",
                  "function gerarDigitos(tamanho) {",
                  "  let valor = '';",
                  "  for (let i = 0; i < tamanho; i++) valor += Math.floor(Math.random() * 10);",
                  "  return valor;",
                  "}",
                  "const stamp = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('createos_stamp', stamp);",
                  "pm.collectionVariables.set('createos_cliente_nome', 'Cliente CreateOS ' + stamp);",
                  "pm.collectionVariables.set('createos_cliente_identificacao', gerarCpfValido());",
                  "pm.collectionVariables.set('createos_cliente_email', 'createos.' + stamp + '@oficina.com');",
                  "pm.collectionVariables.set('createos_veiculo_placa', gerarPlacaMercosul());",
                  "pm.collectionVariables.set('createos_veiculo_renavam', gerarDigitos(11));",
                  "pm.collectionVariables.unset('createos_ordem_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var response = pm.response.json();",
                  "pm.test('Retorna ordemServicoId', function () {",
                  "  pm.expect(response.ordemServicoId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('createos_ordem_id', response.ordemServicoId);"
                ]
              }
            }
          ]
        }
      ]
