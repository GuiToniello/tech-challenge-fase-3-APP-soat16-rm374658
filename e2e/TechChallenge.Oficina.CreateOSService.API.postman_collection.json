                "ordens-servico",
                "completa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": {\n    \"nomeCompleto\": \"Cliente Placa Invalida\",\n    \"identificacao\": \"{{createos_cliente_identificacao}}\",\n    \"email\": \"placa.invalida@oficina.com\"\n  },\n  \"veiculo\": {\n    \"placa\": \"{{createos_placa_invalida}}\",\n    \"marca\": \"Toyota\",\n    \"modelo\": \"Yaris\",\n    \"ano\": 2022,\n    \"renavam\": \"{{createos_veiculo_renavam}}\"\n  },\n  \"servicos\": [\n    {\n      \"nome\": \"Servico Placa Invalida\",\n      \"descricao\": \"Descricao valida\",\n      \"itensServico\": [\n        {\n          \"insumo\": {\n            \"nome\": \"Insumo Placa Invalida\",\n            \"fabricante\": \"Bosch\",\n            \"quantidadeDisponivel\": 10,\n            \"valorUnitario\": 17.5\n          },\n          \"quantidade\": 1\n        }\n      ]\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function gerarCpfValido() {",
                  "  const base = [];",
                  "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
                  "  let soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
                  "  let resto = soma % 11;",
                  "  const d1 = resto < 2 ? 0 : 11 - resto;",
                  "  soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
                  "  soma += d1 * 2;",
                  "  resto = soma % 11;",
                  "  const d2 = resto < 2 ? 0 : 11 - resto;",
                  "  return [...base, d1, d2].join('');",
                  "}",
                  "function gerarDigitos(tamanho) {",
                  "  let valor = '';",
                  "  for (let i = 0; i < tamanho; i++) valor += Math.floor(Math.random() * 10);",
                  "  return valor;",
                  "}",
                  "pm.collectionVariables.set('createos_cliente_identificacao', gerarCpfValido());",
                  "pm.collectionVariables.set('createos_veiculo_renavam', gerarDigitos(11));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Mensagem de placa invalida', function () {",
                  "  var response = pm.response.json();",
                  "  pm.expect((response.message || '').toLowerCase()).to.include('mercosul');",
                  "});"
                ]
              }
            }
          ]
