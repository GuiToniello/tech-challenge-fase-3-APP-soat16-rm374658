        {
          "name": "Criar Cliente Base (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{oficinaApiBaseUrl}}/api/clientes",
              "host": [
                "{{oficinaApiBaseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Cliente StatusService {{status_stamp}}\",\n  \"identificacao\": \"{{status_identificacao}}\",\n  \"email\": \"{{status_email}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function gerarCpfValido() {",
                  "  const base = [];",
                  "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
                  "  let soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
                  "  let resto = soma % 11;",
                  "  const d1 = resto < 2 ? 0 : 11 - resto;",
                  "  soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
                  "  soma += d1 * 2;",
                  "  resto = soma % 11;",
                  "  const d2 = resto < 2 ? 0 : 11 - resto;",
                  "  return [...base, d1, d2].join('');",
                  "}",
                  "function gerarPlacaMercosul() {",
                  "  const letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
                  "  const numeros = '0123456789';",
                  "  return letras[Math.floor(Math.random() * letras.length)] +",
                  "    letras[Math.floor(Math.random() * letras.length)] +",
                  "    letras[Math.floor(Math.random() * letras.length)] +",
                  "    numeros[Math.floor(Math.random() * numeros.length)] +",
                  "    letras[Math.floor(Math.random() * letras.length)] +",
                  "    numeros[Math.floor(Math.random() * numeros.length)] +",
                  "    numeros[Math.floor(Math.random() * numeros.length)];",
                  "}",
                  "function gerarNumero(tamanho) {",
                  "  let valor = '';",
                  "  while (valor.length < tamanho) {",
                  "    valor += Math.floor(Math.random() * 10).toString();",
                  "  }",
                  "  return valor;",
                  "}",
                  "const stamp = Date.now().toString();",
                  "pm.collectionVariables.set('status_stamp', stamp);",
                  "pm.collectionVariables.set('status_identificacao', gerarCpfValido());",
                  "pm.collectionVariables.set('status_email', 'statusservice+' + stamp + '@example.com');",
                  "pm.collectionVariables.set('status_placa', gerarPlacaMercosul());",
                  "pm.collectionVariables.set('status_renavam', gerarNumero(11));",
                  "pm.collectionVariables.unset('status_cliente_id');",
                  "pm.collectionVariables.unset('status_veiculo_id');",
                  "pm.collectionVariables.unset('status_insumo_id');",
                  "pm.collectionVariables.unset('status_servico_id');",
                  "pm.collectionVariables.unset('status_ordem_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var response = pm.response.json();",
                  "pm.test('Cliente criado com id', function () {",
                  "  pm.expect(response.id).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('status_cliente_id', response.id);"
                ]
              }
            }
          ]
