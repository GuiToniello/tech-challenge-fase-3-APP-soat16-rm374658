      "item": [
        {
          "name": "Criar Cliente Base (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{provisioning_auth_access_token}}"
              }
            ],
            "url": {
              "raw": "{{oficinaApiBaseUrl}}/api/clientes",
              "host": [
                "{{oficinaApiBaseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Cliente GetOS {{getos_stamp}}\",\n  \"identificacao\": \"{{getos_identificacao}}\",\n  \"email\": \"{{getos_email}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function gerarCpfValido() {",
                  "  const base = [];",
                  "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
                  "  let soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
                  "  let resto = soma % 11;",
                  "  const d1 = resto < 2 ? 0 : 11 - resto;",
                  "  soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
                  "  soma += d1 * 2;",
                  "  resto = soma % 11;",
                  "  const d2 = resto < 2 ? 0 : 11 - resto;",
                  "  return [...base, d1, d2].join('');",
                  "}",
                  "function gerarPlacaMercosul() {",
                  "  const letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
                  "  const digitos = '0123456789';",
                  "  return letras[Math.floor(Math.random() * 26)] + letras[Math.floor(Math.random() * 26)] + letras[Math.floor(Math.random() * 26)] + digitos[Math.floor(Math.random() * 10)] + letras[Math.floor(Math.random() * 26)] + digitos[Math.floor(Math.random() * 10)] + digitos[Math.floor(Math.random() * 10)];",
                  "}",
                  "function gerarDigitos(tamanho) {",
                  "  let valor = '';",
                  "  for (let i = 0; i < tamanho; i++) valor += Math.floor(Math.random() * 10);",
                  "  return valor;",
                  "}",
                  "const stamp = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('getos_stamp', stamp);",
                  "pm.collectionVariables.set('getos_identificacao', gerarCpfValido());",
                  "pm.collectionVariables.set('getos_email', 'getos.' + stamp + '@oficina.test');",
                  "pm.collectionVariables.set('getos_placa', gerarPlacaMercosul());",
                  "pm.collectionVariables.set('getos_renavam', gerarDigitos(11));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var response = pm.response.json();",
                  "pm.collectionVariables.set('getos_cliente_id', response.id);",
                  "pm.test('ClienteId salvo', function () { pm.expect(pm.collectionVariables.get('getos_cliente_id')).to.be.ok; });"
                ]
              }
            }
          ]
        },
