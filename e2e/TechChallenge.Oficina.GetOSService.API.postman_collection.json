        {
          "name": "Get Ordenadas - Somente Massa da Collection (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{provisioning_auth_access_token}}"
              }
            ],
            "url": {
              "raw": "{{getOSServiceBaseUrl}}/api/ordens-servico/ordenadas",
              "host": [
                "{{getOSServiceBaseUrl}}"
              ],
              "path": [
                "api",
                "ordens-servico",
                "ordenadas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var response = pm.response.json();",
                  "pm.test('Retorna array', function () { pm.expect(Array.isArray(response)).to.eql(true); });",
                  "var idsEsperados = [",
                  "  pm.collectionVariables.get('getos_ordem_recebida_id'),",
                  "  pm.collectionVariables.get('getos_ordem_diagnostico_id'),",
                  "  pm.collectionVariables.get('getos_ordem_aguardando_id'),",
                  "  pm.collectionVariables.get('getos_ordem_execucao_id')",
                  "];",
                  "var idFinalizada = pm.collectionVariables.get('getos_ordem_finalizada_id');",
                  "var apenasDaCollection = response.filter(function (o) { return idsEsperados.indexOf(o.id) >= 0 || o.id === idFinalizada; });",
                  "pm.test('Contem as 4 ordens ativas criadas', function () {",
                  "  var idsRetornados = apenasDaCollection.map(function (o) { return o.id; });",
                  "  idsEsperados.forEach(function (idEsperado) {",
                  "    pm.expect(idsRetornados).to.include(idEsperado);",
                  "  });",
                  "});",
                  "pm.test('Nao contem a ordem finalizada', function () {",
                  "  var idsRetornados = apenasDaCollection.map(function (o) { return o.id; });",
                  "  pm.expect(idsRetornados).to.not.include(idFinalizada);",
                  "});",
                  "var indexExecucao = apenasDaCollection.findIndex(function (o) { return o.id === pm.collectionVariables.get('getos_ordem_execucao_id'); });",
                  "var indexAguardando = apenasDaCollection.findIndex(function (o) { return o.id === pm.collectionVariables.get('getos_ordem_aguardando_id'); });",
                  "var indexDiagnostico = apenasDaCollection.findIndex(function (o) { return o.id === pm.collectionVariables.get('getos_ordem_diagnostico_id'); });",
                  "var indexRecebida = apenasDaCollection.findIndex(function (o) { return o.id === pm.collectionVariables.get('getos_ordem_recebida_id'); });",
                  "pm.test('Ordenacao por prioridade de status', function () {",
                  "  pm.expect(indexExecucao).to.be.at.least(0);",
                  "  pm.expect(indexAguardando).to.be.at.least(0);",
                  "  pm.expect(indexDiagnostico).to.be.at.least(0);",
                  "  pm.expect(indexRecebida).to.be.at.least(0);",
                  "  pm.expect(indexExecucao).to.be.below(indexAguardando);",
                  "  pm.expect(indexAguardando).to.be.below(indexDiagnostico);",
                  "  pm.expect(indexDiagnostico).to.be.below(indexRecebida);",
                  "});",
                  "pm.test('Itens retornam dataAlteracao valida', function () {",
                  "  apenasDaCollection.forEach(function (item) {",
                  "    pm.expect(item.dataAlteracao).to.be.a('string').and.not.empty;",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
