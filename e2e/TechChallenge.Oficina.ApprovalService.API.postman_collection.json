              "host": [
                "{{oficinaApiBaseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Cliente ApprovalService {{approval_stamp}}\",\n  \"identificacao\": \"{{approval_identificacao}}\",\n  \"email\": \"{{approval_email}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function gerarCpfValido() {",
                  "  const base = [];",
                  "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
                  "  let soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
                  "  let resto = soma % 11;",
                  "  const d1 = resto < 2 ? 0 : 11 - resto;",
                  "  soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
                  "  soma += d1 * 2;",
                  "  resto = soma % 11;",
                  "  const d2 = resto < 2 ? 0 : 11 - resto;",
                  "  return [...base, d1, d2].join('');",
                  "}",
                  "function gerarPlacaMercosul() {",
                  "  const letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
                  "  const numeros = '0123456789';",
                  "  return letras[Math.floor(Math.random() * letras.length)] +",
                  "    letras[Math.floor(Math.random() * letras.length)] +",
                  "    letras[Math.floor(Math.random() * letras.length)] +",
                  "    numeros[Math.floor(Math.random() * numeros.length)] +",
                  "    letras[Math.floor(Math.random() * letras.length)] +",
                  "    numeros[Math.floor(Math.random() * numeros.length)] +",
                  "    numeros[Math.floor(Math.random() * numeros.length)];",
                  "}",
                  "function gerarNumero(tamanho) {",
                  "  let valor = '';",
                  "  while (valor.length < tamanho) {",
                  "    valor += Math.floor(Math.random() * 10).toString();",
                  "  }",
                  "  return valor;",
                  "}",
                  "const stamp = Date.now().toString();",
                  "pm.collectionVariables.set('approval_stamp', stamp);",
                  "pm.collectionVariables.set('approval_identificacao', gerarCpfValido());",
                  "pm.collectionVariables.set('approval_email', 'approval+' + stamp + '@example.com');",
                  "pm.collectionVariables.set('approval_placa', gerarPlacaMercosul());",
                  "pm.collectionVariables.set('approval_renavam', gerarNumero(11));",
                  "pm.collectionVariables.unset('approval_cliente_id');",
                  "pm.collectionVariables.unset('approval_veiculo_id');",
                  "pm.collectionVariables.unset('approval_insumo_id');",
                  "pm.collectionVariables.unset('approval_servico_id');",
                  "pm.collectionVariables.unset('approval_ordem_aprovacao_id');",
                  "pm.collectionVariables.unset('approval_ordem_recusa_id');",
                  "pm.collectionVariables.unset('approval_insumo_estoque_id');",
                  "pm.collectionVariables.unset('approval_servico_estoque_id');",
                  "pm.collectionVariables.unset('approval_ordem_estoque_a_id');",
                  "pm.collectionVariables.unset('approval_ordem_estoque_b_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var response = pm.response.json();",
                  "pm.collectionVariables.set('approval_cliente_id', response.id);",
                  "pm.test('Cliente criado', function () { pm.expect(response.id).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ]
        },
